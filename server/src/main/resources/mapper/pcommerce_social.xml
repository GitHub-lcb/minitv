<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.minitv.pcommerce.mapper.PCommerceSocialMapper">

    <!-- Grouped approved comment counts for the drama play page (avoids N+1). -->
    <select id="approvedCommentCounts"
            resultType="us.minitv.pcommerce.dto.PCommerceEpisodeCount">
        SELECT episode_id, COUNT(*) AS total
        FROM comments
        WHERE status = 'approved'
          AND episode_id IN
        <foreach item="id" collection="episodeIds" open="(" separator="," close=")">#{id}</foreach>
        GROUP BY episode_id
    </select>

    <!-- The viewer's own pending rows count for them only. -->
    <select id="pendingCommentCounts"
            resultType="us.minitv.pcommerce.dto.PCommerceEpisodeCount">
        SELECT episode_id, COUNT(*) AS total
        FROM comments
        WHERE status = 'pending'
          AND user_id = #{userId}
          AND episode_id IN
        <foreach item="id" collection="episodeIds" open="(" separator="," close=")">#{id}</foreach>
        GROUP BY episode_id
    </select>

</mapper>
