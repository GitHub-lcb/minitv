<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.minitv.admin.core.mapper.AdminCoreTagMapper">

    <update id="updateFields">
        UPDATE tags
        <set>
            <if test="setNameEn">name_en = #{nameEn},</if>
            <if test="setNameZh">name_zh = #{nameZh},</if>
            <if test="setCategory">category = #{category},</if>
            <if test="setStatus">status = #{status},</if>
            id = id
        </set>
        WHERE id = #{id}
    </update>

</mapper>
