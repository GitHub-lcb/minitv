<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.minitv.partner.mapper.PartnerTagMapper">

    <select id="listEnabled" resultType="us.minitv.content.row.TagRow">
        SELECT id, name_en, name_zh, category, status, created_at
        FROM tags
        WHERE status = 'enabled'
        ORDER BY category, id
    </select>

    <select id="findByIds" resultType="us.minitv.content.row.TagRow">
        SELECT id, name_en, name_zh, category, status, created_at
        FROM tags
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

</mapper>
