<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.minitv.admin.core.mapper.AdminCoreDramaMapper">

    <sql id="listWhere">
        <where>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="q != null and q != ''">AND title LIKE CONCAT('%', #{q}, '%')</if>
            <if test="tagId != null">
                AND id IN (SELECT drama_id FROM drama_tags WHERE tag_id = #{tagId})
            </if>
        </where>
    </sql>

    <select id="list" resultType="us.minitv.content.row.DramaRow">
        SELECT * FROM dramas
        <include refid="listWhere"/>
        ORDER BY updated_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM dramas
        <include refid="listWhere"/>
    </select>

    <update id="updateFields">
        UPDATE dramas
        <set>
            <if test="setTitle">title = #{title},</if>
            <if test="setSynopsis">synopsis = #{synopsis},</if>
            <if test="setCoverUrl">cover_url = #{coverUrl},</if>
            <if test="setFreeEpisodeCount">free_episode_count = #{freeEpisodeCount},</if>
            <if test="setCoinPricePerEpisode">coin_price_per_episode = #{coinPricePerEpisode},</if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{id}
    </update>

</mapper>
