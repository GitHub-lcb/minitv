<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="us.minitv.admin.core.mapper.AdminCoreSupplierMapper">

    <select id="list" resultType="us.minitv.ops.row.SupplierRow">
        SELECT * FROM suppliers
        <where>
            <if test="needle != null and needle != ''">
                AND name LIKE CONCAT('%', #{needle}, '%')
            </if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY id
        LIMIT 200
    </select>

    <update id="updateFields">
        UPDATE suppliers
        <set>
            <if test="setName">name = #{name},</if>
            <if test="setContactName">contact_name = #{contactName},</if>
            <if test="setContactEmail">contact_email = #{contactEmail},</if>
            <if test="setNote">note = #{note},</if>
            updated_at = #{updatedAt}
        </set>
        WHERE id = #{id}
    </update>

</mapper>
